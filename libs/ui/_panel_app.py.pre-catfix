    def backup_list_route() -> Response:
        return jsonify({"backups": _pack.list_backups(), "dir": str(_pack.backups_dir())})

    _compare_job = {"running": False, "done": 0, "total": 0, "progress": 0,
                    "current": "", "result": None, "error": "", "name": ""}

    def _run_compare(name: str, categories: list[str] | None) -> None:
        _compare_job.update({"running": True, "done": 0, "total": 0, "progress": 0,
                             "current": "", "result": None, "error": "", "name": name})
        try:
            def progress(done: int, total: int, arc: str) -> None:
                _compare_job.update({"done": done, "total": total,
                                     "progress": int(done * 100 / max(1, total)),
                                     "current": arc})
            _compare_job["result"] = _pack.compare(_pack.backups_dir() / name, categories,
                                                    progress=progress)
        except Exception as error:  # noqa: BLE001
            _compare_job["error"] = str(error)[:300]
        finally:
            _compare_job["running"] = False

    @app.post("/api/backup/compare")
    def backup_compare_start() -> Response:
        payload = request.get_json(silent=True) or {}
        name = (payload.get("name") or "").strip()
        path = _pack.backups_dir() / name
        if not name or not path.is_file():
            return _json_error("备份不存在", 404)
        if _compare_job.get("running"):
            return _json_error("已有对比任务在运行", 409)
        threading.Thread(target=_run_compare, args=(name, payload.get("categories")),
                         daemon=True).start()
        return jsonify({"started": True, "name": name})

    @app.get("/api/backup/compare/job")
    def backup_compare_job_route() -> Response:
        return jsonify(_compare_job)

    @app.post("/api/backup/restore")
    def backup_restore_route() -> Response:
        payload = request.get_json(silent=True) or {}
        name = (payload.get("name") or "").strip()
        path = _pack.backups_dir() / name
        if not name or not path.is_file():
            return _json_error("备份不存在", 404)
        if payload.get("confirm") is not True:
            return _json_error("还原需要确认（confirm=true）")
        return jsonify(_start_backup_job("restore", {
            "path": str(path), "categories": payload.get("categories"),
            "start_web": bool(payload.get("start_web"))}))

    @app.get("/api/backup/download")
    def backup_download_route() -> Response:
        if request.remote_addr not in ("127.0.0.1", "::1"):
            return _json_error("仅允许本机下载", 403)
        name = (request.args.get("name") or "").strip()
        path = _pack.backups_dir() / name
        if not name or not path.is_file():
            return _json_error("备份不存在", 404)
        return send_file(str(path), as_attachment=True, download_name=name)

