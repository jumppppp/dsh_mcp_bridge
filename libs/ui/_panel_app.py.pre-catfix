    @app.put("/api/webhook")
    def put_webhook() -> Response:
        from ..core import notify

        payload = request.get_json(silent=True) or {}
        url = (payload.get("url") or "").strip()
        if url and not (url.startswith("http://") or url.startswith("https://")):
            return _json_error("url must start with http:// or https://")
        result = notify.save_webhook(locations().state, url,
                                     bool(payload.get("enabled", True)),
                                     payload.get("secret") or "")
        _record_call("webhook_save", detail={"enabled": result["enabled"], "url": url[:80]})
        return jsonify(result)

    # -- stall action (warn | interrupt) -----------------------------------
    @app.get("/api/stall-action")
    def get_stall_action() -> Response:
        path = locations().state / "stall.json"
        persisted = ""
        try:
            if path.is_file():
                persisted = str(json.loads(path.read_text(encoding="utf-8")).get("action") or "")
        except (OSError, ValueError):
            persisted = ""
        env = os.environ.get("DSH_SUBAGENT_STALL_ACTION", "").strip().lower()
        return jsonify({"persisted": persisted or "", "env": env,
                        "effective": "interrupt" if (env or persisted) == "interrupt" else "warn"})

    @app.put("/api/stall-action")
    def put_stall_action() -> Response:
        payload = request.get_json(silent=True) or {}
        action = str(payload.get("action") or "").strip().lower()
        if action not in ("warn", "interrupt"):
            return _json_error("action must be warn or interrupt")
        path = locations().state / "stall.json"
        path.write_text(json.dumps({"action": action}, ensure_ascii=False), encoding="utf-8")
        _record_call("stall_action_save", detail={"action": action})
        return jsonify({"action": action, "note": "对之后启动/重启的服务生效；当前进程需重启后生效"})

