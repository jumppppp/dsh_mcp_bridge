#!/usr/bin/env python3
"""DSH MCP Bridge 控制台（由 main.py panel 启动）。

只需运行这一个程序，然后在浏览器里控制所有东西：

    python main.py panel              # http://127.0.0.1:8765
    python main.py panel --port 9000

面板能力：
  * 总览：统计、运行时信息、健康摘要
  * Agents：启动/继续/中断/关闭/释放/改名/回调，事件流（最终答案/进度/工具）
  * 服务管理：启动/停止/状态/日志
  * MCP：工具清单、DSH 注册状态、配置片段
  * 工作区：按目录聚合、一键在该目录启动
  * 回调：watch 结果文件浏览
  * 自检：doctor 检查项
  * 日志：MCP 日志尾部

面板在后台线程里持有与 MCP/CLI 同一个 Manager，因此页面上的状态就是
桥接的真实状态。默认只绑定 127.0.0.1。
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
import threading
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from flask import Flask, Response, jsonify, render_template_string, request, send_file  # noqa: E402

from libs.core.config import resolve_dsh_cli, runtime_config  # noqa: E402
from libs.core.manager import ACTIVE, Manager  # noqa: E402
from libs.core.platform import APP_VERSION, locations, read_json, write_json  # noqa: E402
from libs.core.projection import project_list, status as project_status  # noqa: E402
from libs.ui.promptgen import build_prompt  # noqa: E402
from libs.transports.server import _TOOL_DEFS  # noqa: E402

VERSION = APP_VERSION


# ---------------------------------------------------------------------------
# Bridge service: one Manager on one event loop in a background thread
# ---------------------------------------------------------------------------

class BridgeService:
    def __init__(self) -> None:
        self.loop = asyncio.new_event_loop()
        self.ready = threading.Event()
        self.manager: Manager | None = None
        self.error: Exception | None = None
        self._thread = threading.Thread(target=self._run, name="bridge-loop", daemon=True)
        self._thread.start()

    def _run(self) -> None:
        asyncio.set_event_loop(self.loop)
        try:
            self.manager = Manager(runtime_config())

            async def _boot() -> None:
                # MUST run inside the loop: _start_watchdog() and create_task()
                # need a running loop. Calling them before run_forever() raised
                # "no running event loop" (swallowed), leaked an un-awaited
                # auto_resume coroutine (RuntimeWarning) and left the panel
                # without stall detection / auto-resume.
                try:
                    self.manager._start_watchdog()
                    await self.manager.auto_resume()
                except Exception:  # noqa: BLE001 - watchdog/recovery are best effort
                    pass

            # loop.create_task schedules it to run as soon as the loop starts.
            self.loop.create_task(_boot())
        except Exception as error:  # noqa: BLE001
            self.error = error
            self.ready.set()
            return
        self.ready.set()
        self.loop.run_forever()

    def get_manager(self, timeout: float = 20.0) -> Manager:
        if not self.ready.wait(timeout):
            raise RuntimeError("bridge loop did not start")
        if self.error is not None:
            raise RuntimeError(f"bridge failed to start: {self.error}")
        if self.manager is None:
            raise RuntimeError("bridge manager is unavailable")
        return self.manager

    def call(self, coro, timeout: float = 60.0) -> Any:
        self.get_manager()
        future = asyncio.run_coroutine_threadsafe(coro, self.loop)
        return future.result(timeout)

    def shutdown(self) -> None:
        if self.manager is not None:
            try:
                self.call(self.manager.shutdown(), timeout=15)
            except Exception:  # noqa: BLE001
                pass
        self.loop.call_soon_threadsafe(self.loop.stop)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _system_dsh_version() -> str | None:
    """Version of the DSH on PATH (what ``dsh --version`` prints).

    ``dsh`` is a shell shim on Windows, so resolve the real npm package behind it
    instead of executing the shim directly.
    """
    import shutil as _shutil

    from ..core.config import _package_entry

    shim = _shutil.which("dsh")
    if shim:
        prefix = Path(shim).parent
        entry = _package_entry(prefix, "@deepseek-ai/dsh", "dsh")
        if entry is not None:
            try:
                return json.loads(
                    (entry.parent.parent / "package.json").read_text(encoding="utf-8")
                ).get("version")
            except (OSError, ValueError):
                pass
    # fallback for non-shim installs
    import subprocess as _sp

    try:
        out = _sp.run(["dsh", "--version"], shell=True, capture_output=True,
                      text=True, timeout=20,
                      creationflags=getattr(_sp, "CREATE_NO_WINDOW", 0))
        return (out.stdout or out.stderr or "").strip() or None
    except Exception:  # noqa: BLE001
        return None


def _runtime_info() -> dict:
    """Installed native DSH Web metadata; no independent Agent process."""
    from ..core import runtime021

    try:
        ver = None
        try:
            ver = json.loads(
                (runtime021.dsh_root() / "package.json").read_text(encoding="utf-8")
            ).get("version")
        except (OSError, ValueError):
            pass
        entry = runtime021.entry()
        from ..core.config import web_profile_patch
        profile = web_profile_patch().parent
        return {
            "command": ["node", str(entry)],
            "version": ver,
            "system_version": _system_dsh_version(),
            "store_version": ver,
            "coherent": True,
            "profile": str(profile),
            "profile_exists": web_profile_patch().is_file(),
            "state": str(locations().state),
            "database": str(locations().state / "state.sqlite"),
            "mode": "021",
        }
    except Exception as error:  # noqa: BLE001
        return {"error": str(error)}


def _mcp_info() -> dict:
    dsh_home = Path(os.environ.get("DSH_HOME") or (Path.home() / ".dsh"))
    candidates = [
        dsh_home / "profiles" / os.environ.get("DSH_PROFILE", "web") / "cordis.patch.yml",
        dsh_home / "profiles" / "web" / "cordis.patch.yml",
    ]
    patch_path = next((p for p in candidates if p.is_file()), None)
    registered = False
    snippet = ""
    if patch_path is not None:
        try:
            text = patch_path.read_text(encoding="utf-8")
            registered = "dsh_mcp_bridge" in text
            if registered:
                lines = text.splitlines()
                for index, line in enumerate(lines):
                    if "dsh-mcp-bridge" in line:
                        snippet = "\n".join(lines[max(0, index - 1): index + 16])
                        break
        except OSError:
            pass
    return {
        "registered": registered,
        "patch": str(patch_path) if patch_path else None,
        "server_name": "dsh_mcp_bridge",
        "tools": [{"name": t.name, "description": (t.description or "").split("\n")[0]} for t in _TOOL_DEFS],
        "snippet": snippet,
    }


def _callbacks() -> list[dict]:
    from datetime import datetime, timezone
    from ..core.diagnostics import error_message
    directory = locations().state / "callbacks"
    if not directory.is_dir():
        return []
    items = []
    for path in directory.glob("*.json"):
        try:
            stat = path.stat()
            payload = json.loads(path.read_text(encoding="utf-8"))
            items.append({
                "name": path.name,
                "path": str(path),
                "mtime": datetime.fromtimestamp(stat.st_mtime, timezone.utc).isoformat().replace("+00:00", "Z"),
                "mtime_epoch_ms": int(stat.st_mtime * 1000),
                "callback_written_at": payload.get("callback_written_at") or payload.get("completed_at"),
                "task_completed_at": payload.get("task_completed_at"),
                "delivery": payload.get("delivery") or {"file": "written", "mcp": "not_recorded", "webhook": "not_recorded", "codex": "not_recorded"},
                "error": error_message(payload),
                "size": stat.st_size,
                "status": payload.get("status"),
                "agent_id": payload.get("agent_id"),
                "answer": (payload.get("answer") or "")[:200],
            })
        except (OSError, ValueError):
            continue
    items.sort(key=lambda item: item["mtime_epoch_ms"], reverse=True)
    return items


def _profiles() -> list[dict]:
    home = Path(os.environ.get("DSH_HOME") or (Path.home() / ".dsh")) / "profiles"
    if not home.is_dir():
        return []
    return [
        {"name": p.name, "path": str(p), "has_patch": (p / "cordis.patch.yml").is_file()}
        for p in sorted(home.iterdir())
        if p.is_dir() and not p.name.startswith(".")
    ]


def service_call(fn, *args, **kwargs):
    """Run a blocking service helper without holding the Flask worker."""
    import concurrent.futures

    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        return pool.submit(fn, *args, **kwargs).result(timeout=60)


def _json_error(message: str, code: int = 400):
    return jsonify({"error": message}), code


# -- call log --------------------------------------------------------------

def _utc_now() -> str:
    """UTC timestamp with a Z suffix; the UI converts it to local time."""
    from datetime import datetime, timezone

    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _memos_file() -> Path:
    return locations().state / "memos.json"


def _load_memos() -> list[dict]:
    path = _memos_file()
    if not path.is_file():
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        rows = data.get("memos") if isinstance(data, dict) else data
        return [m for m in (rows or []) if isinstance(m, dict) and m.get("id")]
    except (OSError, ValueError):
        return []


def _save_memos(memos: list[dict]) -> None:
    write_json(_memos_file(), {"memos": memos})


def _calls_file() -> Path:
    return locations().state / "panel_calls.jsonl"


def _record_call(action: str, agent_id: str | None = None, detail: dict | None = None) -> None:
    entry = {
        "time": _utc_now(),
        "action": action,
        "agent_id": agent_id,
        "detail": detail or {},
    }
    try:
        path = _calls_file()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _recent_calls(limit: int = 100) -> list[dict]:
    """面板 API 操作 + MCP 工具调用合并（按时间倒序）。"""
    sources = [(_calls_file(), "panel")]
    mcp_path = locations().state / "mcp_calls.jsonl"
    if mcp_path.is_file():
        sources.append((mcp_path, "mcp"))
    items: list[dict] = []
    for path, source in sources:
        if not path.is_file():
            continue
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]:
            try:
                item = json.loads(line)
                if source == "mcp":
                    item = {"time": item.get("time", ""), "action": item.get("tool", ""),
                            "agent_id": item.get("session_id") or None,
                            "detail": {"ok": item.get("ok"), "error": item.get("error", "")},
                            "source": "mcp"}
                else:
                    item["source"] = source
                items.append(item)
            except ValueError:
                continue
    items.sort(key=lambda x: str(x.get("time", "")), reverse=True)
    return items[:limit]


# -- model catalog ---------------------------------------------------------

# -- sessions --------------------------------------------------------------

def _bridge_sessions(manager: Manager) -> list[dict]:
    rows = []
    for agent in manager.list():
        rows.append({
            "id": agent["id"],
            "name": agent.get("name") or "",
            "status": agent.get("status") or "",
            "cwd": agent.get("cwd") or "",
            "provider": agent.get("provider"),
            "model": agent.get("model"),
            "external": bool(agent.get("external")),
            "updated_at": agent.get("updated_at"),
            "source": "bridge",
        })
    return rows


# ---------------------------------------------------------------------------
# Flask app
# ---------------------------------------------------------------------------

_BACKUP_SCHEDULER_STARTED = False


def _backup_scheduler_loop() -> None:
    """定时打包线程：每 60s 检查一次是否到期；异常不致命。"""
    from libs.core import dsh_pack

    time.sleep(20)
    while True:
        try:
            settings = dsh_pack.load_settings()
            if dsh_pack.due(settings):
                dsh_pack.rotate(settings)
        except Exception:  # noqa: BLE001
            pass
        time.sleep(60)


def start_backup_scheduler() -> bool:
    global _BACKUP_SCHEDULER_STARTED
    if _BACKUP_SCHEDULER_STARTED:
        return False
    _BACKUP_SCHEDULER_STARTED = True
    threading.Thread(target=_backup_scheduler_loop, daemon=True,
                     name="dsh-backup-scheduler").start()
    return True


def create_app(service: BridgeService | None = None) -> Flask:
    service = service or BridgeService()
    app = Flask(__name__)
    cache, cache_locks, cache_guard = {}, {}, threading.Lock()
    def read_cached(key, loader, ttl=10):
        with cache_guard:
            lock = cache_locks.setdefault(key, threading.Lock())
        with lock:
            now = time.monotonic()
            entry = cache.get(key)
            if entry and now - entry[0] < ttl:
                return entry[1]
            value = loader()
            cache[key] = (time.monotonic(), value)
            return value

    def launch_defaults(cwd=None):
        from ..core.preferences import snapshot, resolve
        state = Path(manager().config.database).parent
        data = snapshot(state=state)
        return {**data, "effective": resolve({"cwd": cwd}, state)}

    def model_catalog():
        return read_cached("models", lambda: service.call(manager().external.web_model_catalog(), timeout=8), 20)

    @app.get("/api/launch-options")
    def launch_options():
        data = launch_defaults(request.args.get("cwd"))
        try:
            catalog = model_catalog()
            data["catalog"] = catalog
            default = catalog.get("default") or {}
            rows = []
            for group in catalog.get("groups") or []:
                for model in group.get("models") or []:
                    reasoning = model.get("reasoning") or {}
                    efforts = [{
                        "id": item.get("id"),
                        "name": item.get("name") or item.get("id"),
                        "description": item.get("description") or "",
                        "default": item.get("id") == reasoning.get("defaultEffort"),
                    } for item in (reasoning.get("efforts") or [])]
                    rows.append({
                        "provider": group.get("id"),
                        "provider_name": group.get("name") or group.get("id"),
                        "model": model.get("id"),
                        "model_name": model.get("name") or model.get("id"),
                        "default": group.get("id") == default.get("provider") and model.get("id") == default.get("model"),
                        "efforts": efforts,
                        "default_effort": reasoning.get("defaultEffort") or "",
                    })
            data["models"] = rows
            data["default_model"] = default
            inventory = read_cached("inventory", lambda: service.call(manager().external.web_inventory(), timeout=8), 30)
            data["presets"] = [{
                "id": row.get("id"),
                "default": bool(row.get("default")),
                "plugins": len(row.get("plugins") or []),
            } for row in inventory.get("agent_presets", [])]
        except Exception:
            data.update(catalog={}, presets=[], models=[], default_model={}, runtime_available=False)
        else:
            data["runtime_available"] = True
        return jsonify(data)

    @app.get("/api/workspace-defaults")
    def get_workspace_defaults():
        from ..core.preferences import snapshot
        return jsonify(snapshot(request.args.get("cwd") or launch_defaults()["effective"]["cwd"], Path(manager().config.database).parent))

    @app.put("/api/workspace-defaults")
    def save_workspace_defaults():
        from ..core.preferences import save, default_workspace, load
        payload = request.get_json(silent=True) or {}
        state = Path(manager().config.database).parent
        cwd = payload.get("cwd") or default_workspace(load(state))
        value = save(cwd, payload.get("settings", {}), payload.get("make_default"), state)
        _record_call("workspace_defaults_saved", detail={"cwd": cwd})
        return jsonify(value)

    @app.get("/api/skills")
    def skill_resources():
        from ..core.skill_catalog import catalog
        return jsonify(catalog(request.args.get("name")))

    app.config["JSON_AS_ASCII"] = False
    token = os.environ.get("DSH_PANEL_TOKEN", "").strip()

    @app.before_request
    def _auth() -> Response | None:
        from urllib.parse import urlsplit
        if not token and urlsplit(request.host_url).hostname not in ("127.0.0.1", "localhost", "::1"):
            return _json_error("Panel authentication required for non-loopback access", 403)
        if request.path.startswith("/api") and request.method in ("POST", "PUT", "PATCH", "DELETE"):
            origin = request.headers.get("Origin")
            if origin and origin.rstrip("/") != request.host_url.rstrip("/"):
                return _json_error("Cross-origin operation refused", 403)
            if not request.is_json:
                return _json_error("JSON content type required", 415)
        if not token or not request.path.startswith("/api"):
            return None
        supplied = request.headers.get("X-Panel-Token") or request.args.get("token")
        if supplied != token:
            return _json_error("invalid panel token", 401)
        return None

    _WEB_CONNECTION_PATHS = {"/api/web/status", "/api/web/url", "/api/web/launch"}

    @app.after_request
    def redact_response(response):
        # 默认脱敏历史日志/错误中的凭据；但 DSH Web 连接类接口按用户要求
        # 返回完整启动链接（含 token），便于直接从面板复制使用。
        if response.is_json and request.path not in _WEB_CONNECTION_PATHS:
            import re
            text = response.get_data(as_text=True)
            text = re.sub(r"(?i)(token=)[^&\s\"\\]+", r"\1[REDACTED]", text)
            text = re.sub(r"(?i)(Bearer\s+)[A-Za-z0-9._~-]+", r"\1[REDACTED]", text)
            response.set_data(text)
        return response

    def manager() -> Manager:
        return service.get_manager()

    # -- page -------------------------------------------------------------
    @app.get("/")
    def index() -> str:
        return render_template_string(PANEL_HTML, version=VERSION,
                                      tool_count=len(_TOOL_DEFS))

    # -- overview ---------------------------------------------------------
    @app.get("/api/overview")
    def overview() -> Response:
        from libs.ui.doctor import run_checks

        agents = manager().list()
        active = sum(1 for a in agents if a.get("status") in ACTIVE)
        completed = sum(1 for a in agents if a.get("status") == "completed")
        bad = sum(1 for a in agents if a.get("status") in ("error", "interrupted", "context_exhausted"))
        checks = read_cached("health", run_checks, 15)
        try:
            inventory = read_cached("inventory", lambda: service.call(manager().external.web_inventory(), timeout=8), 30)
        except Exception as error:
            inventory = {"supported": False, "reason": str(error), "entries": [], "agent_presets": []}
        from libs.transports.httpd import service_status as http_status

        return jsonify({
            "version": VERSION,
            "stats": {"total": len(agents), "active": active, "completed": completed, "bad": bad},
            "http": read_cached("http-status", http_status, 3),
            "runtime": read_cached("runtime", _runtime_info, 30),
            "inventory": inventory,
            "mcp": {"registered": _mcp_info()["registered"]},
            "health": {"ok": all(c["status"] != "error" for c in checks), "checks": checks},
            "recent": [project_status(a) for a in agents[:8]],
        })

    @app.get("/api/health")
    def health() -> Response:
        from libs.ui.doctor import run_checks

        checks = read_cached("health", run_checks, 15)
        return jsonify({
            "ok": all(c["status"] != "error" for c in checks),
            "checks": checks,
        })

    @app.get("/api/runtime")
    def runtime() -> Response:
        return jsonify({"runtime": read_cached("runtime", _runtime_info, 30), "profiles": _profiles(),
                        "execution": "native-web"})

    # -- agents -----------------------------------------------------------
    # -- memos -----------------------------------------------------------
    @app.get("/api/memos")
    def list_memos() -> Response:
        rows = _load_memos()
        query = (request.args.get("q") or "").strip().lower()
        if query:
            rows = [m for m in rows
                    if query in (m.get("title") or "").lower()
                    or query in (m.get("content") or "").lower()
                    or any(query in str(t).lower() for t in (m.get("tags") or []))]
        rows.sort(key=lambda m: (not m.get("pinned"), m.get("updated_at") or ""), reverse=False)
        rows.sort(key=lambda m: (0 if m.get("pinned") else 1, m.get("updated_at") or ""))
        return jsonify({"memos": rows, "total": len(_load_memos())})

    @app.post("/api/memos")
    def create_memo() -> Response:
        payload = request.get_json(silent=True) or {}
        title = (payload.get("title") or "").strip() or "未命名备忘录"
        content = payload.get("content") or ""
        tags = [str(t).strip() for t in (payload.get("tags") or []) if str(t).strip()]
        import uuid as _uuid

        now = _utc_now()
        memo = {
            "id": str(_uuid.uuid4()),
            "title": title,
            "content": content,
            "tags": tags,
            "pinned": bool(payload.get("pinned")),
            "created_at": now,
            "updated_at": now,
        }
        memos = _load_memos()
        memos.insert(0, memo)
        _save_memos(memos)
        _record_call("memo_create", detail={"title": title})
        return jsonify(memo), 201

    @app.put("/api/memos/<memo_id>")
    def update_memo(memo_id: str) -> Response:
        payload = request.get_json(silent=True) or {}
        memos = _load_memos()
        memo = next((m for m in memos if m["id"] == memo_id), None)
        if memo is None:
            return _json_error("memo not found", 404)
        if "title" in payload:
            memo["title"] = (payload.get("title") or "").strip() or memo["title"]
        if "content" in payload:
            memo["content"] = payload.get("content") or ""
        if "tags" in payload:
            memo["tags"] = [str(t).strip() for t in (payload.get("tags") or []) if str(t).strip()]
        if "pinned" in payload:
            memo["pinned"] = bool(payload.get("pinned"))
        memo["updated_at"] = _utc_now()
        _save_memos(memos)
        _record_call("memo_update", detail={"title": memo["title"]})
        return jsonify(memo)

    @app.delete("/api/memos/<memo_id>")
    def delete_memo(memo_id: str) -> Response:
        memos = _load_memos()
        kept = [m for m in memos if m["id"] != memo_id]
        if len(kept) == len(memos):
            return _json_error("memo not found", 404)
        _save_memos(kept)
        _record_call("memo_delete", detail={"id": memo_id})
        return jsonify({"deleted": True, "id": memo_id})

    # -- preamble (前置提示词) -------------------------------------------
    # -- completion webhook ------------------------------------------------
    # -- Codex App Server callback (optional fourth channel) ---------------
    @app.get("/api/codex-callback")
    def get_codex_callback() -> Response:
        from ..core import codex_callback

        config = codex_callback.load_config(locations().state)
        try:
            detected = codex_callback.detect_backend(locations().state)
        except Exception:  # noqa: BLE001
            detected = {"mode": "sync"}
        return jsonify({**config, "codex_version": codex_callback.codex_version(),
                        "detected": detected})

    @app.put("/api/codex-callback")
    def put_codex_callback() -> Response:
        from ..core import codex_callback

        payload = request.get_json(silent=True) or {}
        payload.setdefault("codexVersion", codex_callback.codex_version())
        result = codex_callback.save_config(locations().state, payload)
        _record_call("codex_callback_save", detail={"enabled": result["enabled"]})
        return jsonify(result)

    @app.get("/api/webhook")
