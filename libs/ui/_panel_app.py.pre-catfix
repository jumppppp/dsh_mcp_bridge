    @app.post("/api/backup/start")
    def backup_start() -> Response:
        payload = request.get_json(silent=True) or {}
        ids = payload.get("categories") or _pack.load_settings().get("categories")
        try:
            preview = _pack.plan(ids)
        except Exception as error:  # noqa: BLE001
            return _json_error(str(error)[:200])
        if not preview["total_files"]:
            return _json_error("没有可打包的文件（检查分类或 DSH_HOME）")
        return jsonify(_start_backup_job("backup", {"categories": ids, "name": payload.get("name")}))

