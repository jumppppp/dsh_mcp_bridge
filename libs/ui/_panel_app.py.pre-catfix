            "enabled": data.get("enabled", True),
            "scope": data.get("scope", preamble.DEFAULT_SCOPE),
            "default_template": preamble.DEFAULT_TEMPLATE,
        })

    @app.put("/api/preamble")
    def put_preamble() -> Response:
        from ..core import preamble

        payload = request.get_json(silent=True) or {}
        template = payload.get("template")
        if template is None:
            return _json_error("template is required")
        result = preamble.save_preamble(
            template, bool(payload.get("enabled", True)),
            payload.get("scope") or preamble.DEFAULT_SCOPE,
        )
        _record_call("preamble_save", detail={"enabled": result.get("enabled")})
        return jsonify(result)

    @app.get("/api/agents")
    def list_agents() -> Response:
        rows, summary = project_list(
            manager().list(),
            full=request.args.get("legacy") == "1",
            limit=int(request.args.get("limit", 100)),
            state=request.args.get("status") or None,
            match=request.args.get("match") or None,
        )
        # 运行中的任务附加实时活动（思考中/工具X/等待响应 + 最近事件时间），
        # 任务列表右侧一列即可看到"正在干嘛"，无需打开详情。
        for row in rows:
            if row.get("status") in ("starting", "running", "interrupting"):
                row["activity"] = _activity_now(row["id"])
        return jsonify({"agents": rows, "summary": summary})

    @app.post("/api/agents")
    def start_agent() -> Response:
        payload = request.get_json(silent=True) or {}
        task = (payload.get("task") or "").strip()
        cwd = (payload.get("cwd") or "").strip()
        if not task:
            return _json_error("task is required")
        agent = service.call(manager().start({
            "task": task, "cwd": cwd, "workspace_id": payload.get("workspace_id"),
            "name": payload.get("name") or None,
            "model": payload.get("model") or None,
            "provider": payload.get("provider") or None,
            "effort": payload.get("effort") or None,
            "preset": payload.get("preset") or None,
            "permission": payload.get("permission") or None,
        }))
        return jsonify(project_status(agent)), 201

    @app.get("/api/agents/<agent_id>")
    def get_agent(agent_id: str) -> Response:
        return jsonify(project_status(manager().get(agent_id), full=True))

    def _activity_now(agent_id: str) -> dict | None:
        """Live activity of a running agent derived from its newest real event."""
        try:
            data = manager().events(agent_id, limit=6, latest=True)
        except Exception:  # noqa: BLE001
            return None
        events = [e for e in (data.get("events") or []) if e.get("type") != "stalled"]
        if not events:
            return None
        last = events[-1]
        typ = str(last.get("type") or "")
        payload = last.get("data") or {}
        if typ == "tool/call":
            return {"label": "正在调用工具", "detail": str(payload.get("name") or ""),
                    "since": last.get("time")}
        if typ == "step/start":
            return {"label": "思考中", "detail": "", "since": last.get("time")}
        if typ == "turn/start":
            return {"label": "等待模型响应", "detail": "", "since": last.get("time")}
        if typ == "assistant/message":
            return {"label": "整理回复", "detail": "", "since": last.get("time")}
        if typ == "tool/result":
            message = payload.get("message") if isinstance(payload.get("message"), dict) else {}
            source = (message.get("source") or {}) if isinstance(message, dict) else {}
            return {"label": "处理工具结果", "detail": str(source.get("name") or ""),
                    "since": last.get("time")}
        return {"label": "正在处理", "detail": typ, "since": last.get("time")}

    def _session_system_prompt(agent_id: str) -> str:
        """First system/message text from the session log (DSH shows it as the
        initial system prompt). Best effort; never breaks the trace."""
        try:
            import zstandard as zstd

            roots = [Path("R:/dsh-data/sessions"), Path(__file__).resolve().parent.parent.parent / "data" / "dsh-home-bridge" / "sessions"]
            for root in roots:
                for path in root.glob("**/{}/session.v4.jsonl.zstd".format(agent_id)):
                    raw = path.read_bytes()
                    dctx = zstd.ZstdDecompressor()
                    frames, pos = [], 0
                    while pos < len(raw):
                        obj = dctx.decompressobj()
                        frames.append(obj.decompress(raw[pos:]))
                        used = len(raw[pos:]) - len(obj.unused_data)
                        if used <= 0:
                            break
                        pos += used
                    text = b"".join(frames).decode("utf-8", "replace")
                    import json as _json

                    for line in text.splitlines():
                        if not line.strip():
                            continue
                        try:
                            row = _json.loads(line)
                        except ValueError:
                            continue
                        if row.get("type") != "system/message":
                            continue
                        data = row.get("data") or {}
                        message = data.get("message") or {}
                        content = message.get("content") if isinstance(message, dict) else None
                        blocks = content if isinstance(content, list) else []
                        parts = [b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text"]
                        if parts and "".join(parts).strip():
                            return "".join(parts)[:1500]
                    return ""
        except Exception:  # noqa: BLE001
            return ""
        return ""

    def _parse_event_ms(value) -> int:
        if value is None:
            return 0
        if isinstance(value, (int, float)):
            return int(value)
        try:
            text = str(value).strip()
            if text.lower().endswith("z"):
                text = text[:-1] + "+00:00"
            from datetime import datetime as _dt

            return int(_dt.fromisoformat(text).timestamp() * 1000)
        except Exception:  # noqa: BLE001
            return 0

    @app.get("/api/agents/<agent_id>/chat")
    def agent_chat(agent_id: str) -> Response:
        """Conversation stream: what the client sent / DSH replied / tool calls.

        ``?before=<seq>`` returns the newest events STRICTLY older than the
        cursor (chronological), so long sessions can page back to the start
        instead of silently truncating at the newest 500 events.
        """
        # events() is synchronous; call it directly instead of through the loop.
        before = int(request.args.get("before", 0) or 0)
        data = manager().events(agent_id, limit=500, latest=(before <= 0), before=before or None)
        agent = manager().get(agent_id)
        items = []
        for event in data.get("events", []):
            typ = event["type"]
            ev_data = event.get("data") or {}
            if typ == "bridge/prompt":
                items.append({"role": "user", "text": str(ev_data.get("task") or "")[:4000],
                              "time": event["time"], "seq": event.get("seq")})
            elif typ == "assistant/message":
                items.append({"role": "assistant",
                              "text": str(ev_data.get("text") or "")[:6000],
                              "time": event["time"], "seq": event.get("seq"),
                              "usage": ev_data.get("usage")})
            elif typ == "tool/call":
                name = str(ev_data.get("name") or "")
                args = str(ev_data.get("arguments") or "")
                args = args[:220] + ("…" if len(args) > 220 else "")
                call_id = str(ev_data.get("callId") or "")
                items.append({"role": "tool", "name": name, "text": args,
                              "time": event["time"], "call_id": call_id,
                              "seq": event.get("seq")})
            elif typ == "tool/result":
                if items and items[-1]["role"] == "tool":
                    message = ev_data.get("message") or {}
                    content = message.get("content") if isinstance(message, dict) else None
                    summary = str(content or message)[:200]
                    items[-1]["result"] = summary + ("…" if len(summary) >= 200 else "")
                    start_ms = _parse_event_ms(items[-1].get("time"))
                    end_ms = _parse_event_ms(event.get("time"))
                    if start_ms and end_ms:
                        items[-1]["duration_ms"] = max(0, end_ms - start_ms)
            elif typ in ("state/set", "step/start", "turn/end"):
                items.append({"role": "meta", "text": typ,
                              "time": event["time"], "seq": event.get("seq"),
                              "detail": str(ev_data)[:120]})
        # current activity (DSH shows "what is happening now" while running)
        status = str(agent.get("status") or "")
        activity = None
        events = data.get("events") or []
        if status in ("starting", "running", "interrupting") and events:
            last = events[-1]
            last_type = last["type"]
            last_data = last.get("data") or {}
            if last_type == "tool/call":
                activity = {"kind": "tool", "name": str(last_data.get("name") or ""),
                            "since": last.get("time"), "label": "正在调用工具"}
            elif last_type == "step/start":
                activity = {"kind": "thinking", "since": last.get("time"), "label": "思考中"}
            elif last_type == "turn/start":
                activity = {"kind": "turn", "since": last.get("time"), "label": "等待模型响应"}
            elif last_type == "assistant/message":
                activity = {"kind": "reply", "since": last.get("time"), "label": "整理回复"}
            else:
                activity = {"kind": "other", "since": last.get("time"),
                            "label": "正在处理", "detail": last_type}
        events_list = data.get("events") or []
        next_before = events_list[0]["seq"] if events_list else 0
        return jsonify({"chat": items, "count": len(items), "status": status,
                        "activity": activity, "stalled": bool(agent.get("stalled")),
                        "stalled_since": agent.get("stalled_since"),
                        "created_at": agent.get("created_at"),
                        "updated_at": agent.get("updated_at"),
                        "next_before": next_before,
                        "has_more": manager().has_events_before(agent_id, next_before),
                        "total": manager().count_events(agent_id)})

    @app.get("/api/agents/<agent_id>/trace")
    def agent_trace(agent_id: str) -> Response:
        """Per-turn execution records: tool calls paired with results/durations,
        steps, approvals, boundaries. Chat text (user/assistant messages) is
        intentionally NOT repeated here — it lives in the 对话 tab only; the
        事件 tab shows the raw event stream."""
        before = int(request.args.get("before", 0) or 0)
        data = manager().events(agent_id, limit=800, latest=(before <= 0), before=before or None)
        agent = manager().get(agent_id)
        first_seq = (data.get("events") or [{}])[0].get("seq") or 0
        turns: list[dict] = []
        current = None
        pending: dict[str, dict] = {}

        def new_turn(number) -> dict:
            turn = {"turn": number, "records": []}
            turns.append(turn)
            return turn

        def record(kind: str, **fields) -> dict:
            nonlocal current
            if current is None:
                current = new_turn(None)
            row = {"kind": kind, "time": fields.pop("time", None), **fields}
            current["records"].append(row)
            return row

        for event in data.get("events", []):
            typ = event["type"]
            d = event.get("data") or {}
            t = event.get("time")
            if typ == "turn/start":
                current = new_turn(d.get("turn"))
                current["started_at"] = t
                current["records"].append({"kind": "boundary", "label": "轮次开始", "time": t})
            elif typ == "turn/end":
                if current is not None:
                    current["ended_at"] = t
                    current["records"].append({"kind": "boundary", "label": "轮次结束", "time": t})
            elif typ == "step/start":
                record("step", label="步骤 {}".format(d.get("step") or ""), time=t)
            elif typ == "system/message":
                message = d.get("message") or {}
                content = message.get("content") if isinstance(message, dict) else None
                text = str(content or message)[:800]
                if text.strip():
                    record("system", label="系统", text=text, time=t)
            elif typ == "bridge/prompt":
                # 对话内容只在「对话」标签显示；轨迹不重复。
                continue
            elif typ == "assistant/message":
                # 同上：助手消息属于对话，不进轨迹表。
                continue
            elif typ == "tool/call":
                call_id = str(d.get("callId") or "")
                row = record("tool", name=str(d.get("name") or ""),
                             args=str(d.get("arguments") or "")[:400],
                             call_id=call_id, time=t, status="running", duration_ms=None)
                if call_id:
                    pending[call_id] = row
            elif typ == "tool/result":
                message = d.get("message") or {}
                source = message.get("source") if isinstance(message, dict) else {}
                call_id = str((source or {}).get("callId") or "")
                content = message.get("content") if isinstance(message, dict) else None
                row = pending.pop(call_id, None) if call_id else None
                if row is None:
                    row = record("tool", name=str((source or {}).get("name") or "tool"),
                                 args="", call_id=call_id, time=t, status="done", duration_ms=None)
                row["result"] = str(content or message)[:1200]
                row["status"] = "done"
                row["ended_at"] = t
                start_ms = _parse_event_ms(row.get("time"))
                end_ms = _parse_event_ms(t)
                row["duration_ms"] = max(0, end_ms - start_ms) if start_ms and end_ms else None
            elif typ in ("approval/asked", "approval/decided", "approval/policy", "permission/preset", "sandbox/mode"):
                record("approval", label=typ, detail=str(d)[:200], time=t)
            elif typ in ("compaction/start", "compaction/end", "compaction/summary"):
                record("compaction", label=typ, detail=str(d)[:200], time=t)
            elif typ == "interrupted":
                record("interrupt", label="中断", detail=str(d.get("reason") or "")[:160], time=t)
            elif typ == "stalled":
                # 连续停滞只保留一条，避免每 3 分钟刷屏（真实信号在活动条/事件页）
                if current is not None and current["records"] and current["records"][-1]["kind"] == "stall":
                    continue
                record("stall", label="停滞", detail=str(d)[:160], time=t)
        prompt_text = _session_system_prompt(agent_id)
        if prompt_text:
            if turns:
                turns[0]["records"].insert(0, {"kind": "system", "label": "初始系统提示词",
                                               "text": prompt_text, "time": turns[0].get("started_at")})
            else:
                turns.insert(0, {"turn": None, "records": [{"kind": "system", "label": "初始系统提示词",
                                                             "text": prompt_text, "time": None}]})
        return jsonify({
            "trace": turns,
            "status": agent.get("status"),
            "stalled": bool(agent.get("stalled")),
            "stalled_since": agent.get("stalled_since"),
            "finish_reason": agent.get("finish_reason"),
            "started_at": agent.get("created_at"),
            "updated_at": agent.get("updated_at"),
            "next_before": first_seq,
            "has_more": manager().has_events_before(agent_id, first_seq),
            "total": manager().count_events(agent_id),
        })

    @app.get("/api/agents/<agent_id>/events")
    def get_events(agent_id: str) -> Response:
        before = int(request.args.get("before", 0) or 0)
        result = manager().public_events(
