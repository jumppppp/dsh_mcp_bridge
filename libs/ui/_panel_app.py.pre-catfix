    @app.get("/api/callbacks/<name>")
    def callback_content(name: str) -> Response:
        if "/" in name or "\\" in name or name.startswith("."):
            return _json_error("invalid callback name", 400)
        path = locations().state / "callbacks" / name
        if not path.is_file():
            return _json_error("callback not found", 404)
        return Response(path.read_text(encoding="utf-8", errors="replace"), mimetype="application/json")

