    @app.post("/api/web-sessions/<session_id>/send")
    def web_session_send_route(session_id: str) -> Response:
        payload = request.get_json(silent=True) or {}
        task = (payload.get("task") or "").strip()
        if not task:
            return _json_error("task is required")
        web_url = (payload.get("web_url") or "").strip()
        if payload.get("mode", "queue") not in ("queue", "steer"):
            return _json_error("mode must be queue or steer")
        try:
            value = service.call(manager().external.web_send(
                session_id, task, payload.get("mode") or "queue", web_url))
        except Exception as error:  # noqa: BLE001
            return _json_error(str(error)[:200], 502)
        _record_call("web_send", session_id, {"task": task[:80]})
        return jsonify({"accepted": True, "status": value.get("status"), "mode": payload.get("mode", "queue"), "execution_confirmed": False})

