    @app.post("/api/web-sessions/archive-many")
    def web_sessions_archive_many() -> Response:
        payload = request.get_json(silent=True) or {}
        if payload.get("confirm") is not True:
            return _json_error("需要确认（confirm=true）")
        ids = payload.get("session_ids")
        import re
        if not isinstance(ids, list) or not ids or any(not isinstance(sid, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", sid) for sid in ids):
            return _json_error("无效会话 ID")
        archived, skipped = [], []
        for sid in dict.fromkeys(ids):
            try:
                service.call(manager().external.web_archive(sid, True, False))
                archived.append(sid)
            except Exception as error:
                skipped.append({"id": sid, "reason": str(error)[:200]})
        _record_call("web_archive_many", detail={"archived": len(archived), "skipped": len(skipped)})
        return jsonify({"archived": archived, "skipped": skipped})

