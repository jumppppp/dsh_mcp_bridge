    # -- workspaces -------------------------------------------------------
    @app.get("/api/workspaces")
    def workspaces() -> Response:
        buckets: dict[str, dict] = {}
        for agent in manager().list():
            cwd = agent.get("cwd") or ""
            if not cwd:
                continue
            bucket = buckets.setdefault(cwd, {
                "cwd": cwd, "count": 0, "last": agent.get("updated_at"),
                "names": [], "exists": Path(cwd).is_dir(),
            })
            bucket["count"] += 1
            if agent.get("updated_at") and (bucket["last"] or "") < agent["updated_at"]:
                bucket["last"] = agent["updated_at"]
            if agent.get("name") and len(bucket["names"]) < 3:
                bucket["names"].append(agent["name"])
        rows = sorted(buckets.values(), key=lambda r: r["last"] or "", reverse=True)
        from ..core.preferences import snapshot
        settings = snapshot(state=Path(manager().config.database).parent)
        for entry in settings["workspaces"].values():
            cwd = entry["cwd"]
            if not any(row["cwd"] == cwd for row in rows):
                rows.append({"cwd": cwd, "count": 0, "last": None, "exists": Path(cwd).is_dir()})
        cwd = settings["default_workspace"]
        if not any(row["cwd"] == cwd for row in rows):
            rows.insert(0, {"cwd": cwd, "count": 0, "last": None, "exists": Path(cwd).is_dir()})
        try:
            native = read_cached("native-workspaces", lambda: service.call(manager().external.web_workspaces(), timeout=8), 10)
            for entry in native.get("workspaces", []):
                cwd = entry.get("path")
                if cwd and not any(row["cwd"] == cwd for row in rows):
                    rows.append({"cwd": cwd, "workspace_id": entry.get("workspaceId"), "count": len(entry.get("sessionIds", [])), "last": None, "exists": Path(cwd).is_dir()})
        except Exception:
            pass
        return jsonify({"workspaces": rows, "default_workspace": settings["default_workspace"]})

