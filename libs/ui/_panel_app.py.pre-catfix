    # ---- DSH 打包 / 备份 / 还原 ----
    from libs.core import dsh_pack as _pack

    _backup_job = {"running": False, "kind": "", "progress": 0, "total": 0, "done": 0,
                   "bytes_done": 0, "bytes_total": 0, "current": "", "log": [],
                   "result": None, "error": "", "started_at": ""}

    def _backup_categories() -> list[dict]:
        rows = [{"id": name, "label": spec["label"], "default": bool(spec.get("default")),
                 "huge": bool(spec.get("huge")), "sensitive": bool(spec.get("sensitive"))}
                for name, spec in _pack.CATEGORIES.items()]
        names = [item["name"] for item in _pack.extra_categories()]
        if names:
            for row in rows:
                if row["id"] == "extras":
                    row["detail"] = "包含 " + "、".join(names[:6]) + ("…" if len(names) > 6 else "")
        return rows

    def _run_backup_job(kind: str, payload: dict) -> None:
        _backup_job.update({"running": True, "kind": kind, "progress": 0, "total": 0,
                            "done": 0, "bytes_done": 0, "bytes_total": 0, "current": "", "log": [],
                            "result": None, "error": "",
                            "started_at": time.strftime("%Y-%m-%dT%H:%M:%S")})
        try:
            if kind == "backup":
                def progress(done: int, total: int, _size: int, arc: str = "",
                             written_bytes: int = 0, total_bytes: int = 0) -> None:
                    log = _backup_job.setdefault("log", [])
                    if arc:
                        log.append(arc)
                        del log[:-8]
                    _backup_job.update({"done": done, "total": total,
                                        "progress": int(done * 100 / max(1, total)),
                                        "bytes_done": written_bytes, "bytes_total": total_bytes,
                                        "current": arc})
                _backup_job["result"] = _pack.build(payload.get("categories"),
                                                    name=payload.get("name"), progress=progress)
                _pack.prune()
            elif kind == "restore":
                result = _pack.restore(Path(payload["path"]), payload.get("categories"),
                                       confirm=True, safety=True)
                if payload.get("start_web"):
                    try:
                        from libs.transports import web_control
                        result["web_start"] = web_control.start(int(os.environ.get("DSH_WEB_PORT", "3080")))
                    except Exception as error:  # noqa: BLE001
                        result["web_start"] = {"error": str(error)[:200]}
                _backup_job["result"] = result
        except Exception as error:  # noqa: BLE001
            _backup_job["error"] = str(error)[:400]
        finally:
            _backup_job["running"] = False

    def _start_backup_job(kind: str, payload: dict) -> dict:
        if _backup_job.get("running"):
            return {"started": False, "reason": "已有备份/还原任务在运行"}
        threading.Thread(target=_run_backup_job, args=(kind, payload), daemon=True).start()
        return {"started": True, "kind": kind}

    @app.get("/api/backup/categories")
    def backup_categories_route() -> Response:
        return jsonify({"categories": _backup_categories(), "settings": _pack.load_settings()})

