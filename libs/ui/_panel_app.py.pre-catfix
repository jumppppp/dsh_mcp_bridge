    @app.get("/api/sessions")
    def sessions() -> Response:
        by_id = {row["id"]: row for row in _bridge_sessions(manager())}
        warning = None
        try:
            for item in service.call(manager().external.web_sessions()):
                by_id.setdefault(item["session_id"], {
                    "id": item["session_id"], "name": item.get("title") or "",
                    "status": "running" if item.get("running") else "idle",
                    "cwd": item.get("cwd"), "provider": item.get("provider"),
                    "model": item.get("model"), "external": True, "source": "dsh-web"})
        except Exception as error:
            warning = str(error)
        return jsonify({"sessions": list(by_id.values()), "warning": warning})

