    from ..transports.web_control import WebControl, OperationBusy
    web_control = WebControl(locations().state)

    @app.get("/api/web/operation")
    def web_operation():
        return jsonify(web_control.snapshot())

    @app.post("/api/web/start")
    def web_start_operation():
        payload = request.get_json(silent=True) or {}
        try:
            operation = web_control.start(payload.get("port", 3080))
        except OperationBusy as error:
            return _json_error(str(error), 409)
        except ValueError as error:
            return _json_error(str(error), 400)
        _record_call("web_start_requested", detail={"operation_id": operation["id"]})
        return jsonify(operation), 202

    @app.post("/api/web/stop")
    def web_stop_operation():
        payload = request.get_json(silent=True) or {}
        try:
            operation = web_control.stop(payload.get("confirm"))
        except OperationBusy as error:
            return _json_error(str(error), 409)
        except ValueError as error:
            return _json_error(str(error), 400)
        _record_call("web_stop_requested", detail={"operation_id": operation["id"]})
        return jsonify(operation), 202

    @app.get("/api/web/status")
    def web_status() -> Response:
        from libs.transports import web_launch as web_module

        # 面板展示完整启动链接（含 token）：用户需要直接从面板复制使用
        return jsonify(web_module.status(locations().state, probe=True) if request.args.get("fresh") == "1"
                       else read_cached("web-status", lambda: web_module.status(locations().state, probe=True), 5))

    @app.post("/api/web/launch")
    def web_launch() -> Response:
        if web_control.snapshot()["state"] == "running":
            return _json_error("Web 启动/停止正在进行，请稍后重试", 409)
        from libs.transports import web_launch as web_module

        payload = request.get_json(silent=True) or {}
        try:
            result = web_module.launch(locations().state, port=int(payload.get("port") or 3080))
        except Exception as error:  # noqa: BLE001
            return _json_error(str(error))
        for key in ("web-status", "models", "inventory", "native-workspaces"):
            cache.pop(key, None)
        _record_call("web_launch", detail=result)
        return jsonify(result)

    @app.put("/api/web/url")
    def web_url() -> Response:
        if web_control.snapshot()["state"] == "running":
            return _json_error("Web 启动/停止正在进行，请稍后保存连接", 409)
        from libs.transports import web_launch as web_module

        payload = request.get_json(silent=True) or {}
        try:
            result = web_module.save_url(locations().state, str(payload.get("url") or ""))
        except Exception as error:  # noqa: BLE001
            return _json_error(str(error))
        for key in ("web-status", "models", "inventory", "native-workspaces"):
            cache.pop(key, None)
        return jsonify(result)

