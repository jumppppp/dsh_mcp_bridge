    @app.get("/api/web/diagnostics")
    def web_diagnostics() -> Response:
        from libs.transports import web_launch as web_module
        from libs.core.secrets import read_secret_json

        state = locations().state
        log_path = state / "web-launch.log"
        tail: list[str] = []
        if log_path.is_file():
            try:
                tail = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-200:]
            except OSError:
                pass
        record = {}
        try:
            record = read_secret_json(state / "web_launch.json")
        except Exception:  # noqa: BLE001
            record = {}
        return jsonify({
            "log_tail": "\n".join(tail),
            "exit": web_module.read_web_exit(state),
            "record": {k: record.get(k) for k in ("command", "started_at", "pid") if record.get(k) is not None},
        })

    @app.get("/api/http")
    def http_status() -> Response:
        from libs.transports.httpd import service_status

        return jsonify(read_cached("http-status", service_status, 3))

    @app.post("/api/http/<action>")
    def http_control(action: str) -> Response:
        from ..transports import httpd

        if action == "start":
            result = service_call(httpd.start_service)
            cache.pop("http-status", None)
            _record_call("http_start", detail={"started": result.get("started")})
            return jsonify(result)
        if action == "stop":
            payload = request.get_json(silent=True) or {}
            result = service_call(httpd.stop_service, force=bool(payload.get("force")))
            cache.pop("http-status", None)
            _record_call("http_stop", detail={"stopped": result.get("stopped"),
                                               "force": bool(payload.get("force"))})
            return jsonify(result)
        return _json_error(f"unknown http action: {action}", 404)

    @app.get("/api/http/logs")
    def http_logs() -> Response:
        path = locations().state / "http.log"
        lines = int(request.args.get("lines", 120))
        if not path.is_file():
            return jsonify({"lines": [], "path": str(path), "exists": False})
        text = path.read_text(encoding="utf-8", errors="replace").splitlines()
        return jsonify({"lines": text[-lines:], "path": str(path), "exists": True})

