        result["total"] = manager().count_events(agent_id)
        result["has_more"] = manager().has_events_before(agent_id, int(result.get("oldest_seq") or 0))
        return jsonify(result)

    @app.post("/api/agents/<agent_id>/resume")
    def resume_agent(agent_id: str) -> Response:
        """Continue an interrupted task on its original session."""
        payload = request.get_json(silent=True) or {}
        task = (payload.get("task") or "").strip()
        if not task:
            task = "请检查当前执行进度，继续完成本次任务，完成后汇报结果。"
        agent = manager().get(agent_id)
        if agent.get("status") not in ("interrupted", "idle", "completed"):
            return _json_error("只有 interrupted / idle / completed 的任务可恢复执行", 400)
        result = service.call(manager().followup(agent_id, task))
        _record_call("resume", agent_id, {"name": agent.get("name")})
        return jsonify(project_status(result))

    @app.post("/api/agents/<agent_id>/followup")
    def followup(agent_id: str) -> Response:
        payload = request.get_json(silent=True) or {}
        task = (payload.get("task") or "").strip()
        mode = payload.get("mode", "queue")
        if not task or mode not in ("queue", "steer"):
            return _json_error("task is required; mode must be queue or steer")
        return jsonify(project_status(service.call(manager().followup(agent_id, task, mode, False))))

    async def call_interaction_bridge(arguments: dict) -> dict:
        from datetime import timedelta
        from mcp.client.streamable_http import streamablehttp_client
        from mcp import ClientSession
        from libs.transports import httpd
        host, port = httpd.address()
        if host not in ("127.0.0.1", "localhost", "::1"):
            raise ValueError("Interaction relay requires a local MCP endpoint")
        token = httpd.token_file().read_text(encoding="utf-8").strip()
        address = "[::1]" if host == "::1" else host
        async def invoke():
            async with streamablehttp_client(f"http://{address}:{port}/mcp", headers={"Authorization": "Bearer " + token}) as (read, write, _):
                async with ClientSession(read, write, read_timeout_seconds=timedelta(seconds=35)) as client:
                    await client.initialize()
                    result = await client.call_tool("dsh_session", arguments)
                    text = next((item.text for item in result.content if item.type == "text"), "{}")
                    if result.isError:
                        raise ValueError(text[:300])
                    return json.loads(text)
        return await asyncio.wait_for(invoke(), timeout=40)

    @app.route("/api/session-interactions/<session_id>", methods=["GET", "POST"])
    def session_interactions(session_id: str) -> Response:
        payload = request.get_json(silent=True) or {} if request.method == "POST" else {}
        action = payload.get("action", "interactions")
        if request.method == "GET":
            action = "interactions"
        if action not in ("interactions", "interaction_enable", "interaction_disable", "interaction_reply"):
            return _json_error("Invalid interaction action")
        arguments = {"action": action, "session_id": session_id}
        for key in ("interaction_id", "decision", "answers", "confirm"):
            if key in payload:
                arguments[key] = payload[key]
        try:
            return jsonify(service.call(call_interaction_bridge(arguments), timeout=45))
        except Exception as error:
            return _json_error(str(error)[:300], 502)

